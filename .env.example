# Copy to `.env` and fill the values locally. Safe placeholders only.

NODE_ENV=development

# Local Supabase PostgreSQL (used by Drizzle). Ports come from supabase/config.toml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Redis (query cache + BullMQ queue namespace).
REDIS_URL=redis://127.0.0.1:6379

# Local Supabase API gateway (REST, Auth, Storage). Kong listens on 54321.
SUPABASE_URL=http://127.0.0.1:54321

# Print the two keys with `supabase status` and paste them into your local .env.
# The local anon/service keys are deterministic; do not commit a real .env.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
